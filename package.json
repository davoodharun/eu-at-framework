{
  "name": "eu-automated-tests",
  "version": "1.0.0",
  "description": "Integration and E2E testing framework for EU operating companies",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --reporter=json,junit",
    "test:e2e": "playwright test --grep @e2e",
    "test:integration": "playwright test --grep @integration",
    "test:login": "playwright test --grep @login",
    "test:outages": "playwright test --grep @outages",
    "test:payments": "playwright test --grep @payments",
    "test:stage": "playwright test --config=playwright.stage.config.ts",
    "test:prod": "playwright test --config=playwright.prod.config.ts",
    "test:stage:ci": "playwright test --config=playwright.stage.config.ts",
    "test:prod:ci": "playwright test --config=playwright.prod.config.ts",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:multi-opco": "playwright test --grep @multi-opco",
    "test:multi-opco:stage": "playwright test --config=playwright.stage.config.ts --grep @multi-opco",
    "test:multi-opco:prod": "playwright test --config=playwright.prod.config.ts --grep @multi-opco",
    "test:multi-opco:stage:ci": "playwright test --config=playwright.stage.config.ts --grep @multi-opco --reporter=json,junit",
    "test:multi-opco:prod:ci": "playwright test --config=playwright.prod.config.ts --grep @multi-opco --reporter=json,junit",
    "test:login:bge": "cross-env OPCO_LIST=bge playwright test --grep @login",
    "test:login:com": "cross-env OPCO_LIST=com playwright test --grep @login",
    "test:login:pec": "cross-env OPCO_LIST=pec playwright test --grep @login",
    "test:login:ace": "cross-env OPCO_LIST=ace playwright test --grep @login",
    "test:login:dpl": "cross-env OPCO_LIST=dpl playwright test --grep @login",
    "test:login:pep": "cross-env OPCO_LIST=pep playwright test --grep @login",
    "test:login:all": "cross-env OPCO_LIST=bge,com,pec,ace,dpl,pep playwright test --grep @login",
    "test:login:phi": "npx cross-env OPCO_LIST=ace,dpl,pep npx playwright test tests/e2e/generated-login.spec.ts",
    "test:login:stage": "cross-env OPCO_LIST=bge,com,pec,ace,dpl,pep playwright test --config=playwright.stage.config.ts --grep @login",
    "test:login:prod": "cross-env OPCO_LIST=bge,com,pec,ace,dpl,pep playwright test --config=playwright.prod.config.ts --grep @login",
    "test:api:bge": "cross-env OPCO_LIST=bge playwright test --grep @api",
    "test:api:stage": "cross-env OPCO_LIST=bge,com,pec,ace,dpl,pep playwright test --config=playwright.stage.config.ts --grep @api",
    "test:api:prod": "cross-env OPCO_LIST=bge,com,pec,ace,dpl,pep playwright test --config=playwright.prod.config.ts --grep @api",
    "install-browsers": "playwright install",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "integration",
    "automation"
  ],
  "author": "EU Testing Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
